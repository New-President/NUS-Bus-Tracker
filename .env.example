# Supabase Database Configuration (Required)
# Use Transaction Pooler URI (port 6543) or Session Pooler (port 5432)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Provider Settings (Optional)
# auto (default): direct uNivUS with community fallback
# univus: direct uNivUS only
# community: public arrivals fallback only
# connectx: legacy ConnectX fallback
BUS_PROVIDER=auto
FMS_ROUTES=A1,A2,D1,D2,E,K,R1,R2
BUS_STOPS=UTOWN,KR-MRT

# Administration Token (Optional)
# Leave blank for local development. Set a random secret on production to protect settings and history deletion.
ADMIN_TOKEN=

# Local Server Port (Optional)
HOST=127.0.0.1
PORT=3000

# cron-job.org API Key (Optional)
# Synchronizes the web countdown with your external cron job schedule
CRONJOB_API_KEY=

